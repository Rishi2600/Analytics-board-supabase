# Copy to .env.local and fill in. Never commit the filled copy.
#
# Naming rule that matters more than any other on this stack: Vite inlines every variable
# prefixed with VITE_ into the browser bundle. A secret with that prefix is a published
# secret. Anything without the prefix stays server side, which here means Edge Function
# secrets and local scripts.

# ---------------------------------------------------------------------------
# Client - safe to ship in the browser bundle (phase 1)
# ---------------------------------------------------------------------------

# The REST URL of the Supabase project, for example https://abcdefgh.supabase.co
VITE_SUPABASE_URL=

# The anon key, called the publishable key in newer Supabase projects. It is public by
# design and is useless on its own, because every table is protected by row level
# security. If RLS is ever switched off on a table, this key is what reads it.
VITE_SUPABASE_ANON_KEY=

# ---------------------------------------------------------------------------
# Server side only - never prefix these with VITE_ (phase 1 onward)
# ---------------------------------------------------------------------------

# The project reference, the subdomain part of the URL above. Used by the Supabase CLI.
SUPABASE_PROJECT_REF=

# Bypasses row level security completely. Used by Edge Functions and by the seed and
# backfill scripts. If this ever reaches a browser, treat it as a full data breach and
# rotate it immediately. See docs/RUNBOOK.md.
SUPABASE_SERVICE_ROLE_KEY=

# Direct Postgres connection string, used by the seed and backfill scripts (phase 5).
SUPABASE_DB_URL=

# ---------------------------------------------------------------------------
# Edge Function secrets - set with `npx supabase secrets set NAME=value` (phase 4)
# ---------------------------------------------------------------------------

# Salt for the daily rotating IP hash. Raw IP addresses are never stored. Rotating this
# breaks the link between yesterday's and today's hashes, which is the intent.
INGEST_IP_HASH_SALT=
