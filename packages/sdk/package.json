{
  "name": "@analytics/sdk",
  "version": "1.0.0",
  "description": "The snippet customers install to send events to the analytics ingestion API.",
  "type": "module",
  "main": "./dist/analytics.js",
  "module": "./dist/analytics.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/analytics.js",
      "require": "./dist/analytics.cjs"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "vite build",
    "typecheck": "tsc -p tsconfig.json",
    "size": "node ./scripts/report-size.mjs"
  },
  "devDependencies": {
    "typescript": "~6.0.2",
    "vite": "^8.3.0"
  }
}
