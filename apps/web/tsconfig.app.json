{
  "compilerOptions": {
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.app.tsbuildinfo",
    "target": "es2023",
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "module": "esnext",
    "types": ["vite/client"],
    "allowArbitraryExtensions": true,
    "skipLibCheck": true,

    /* Bundler mode */
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": true,
    "moduleDetection": "force",
    "noEmit": true,
    "jsx": "react-jsx",

    /* Path alias - shadcn/ui requires this in both tsconfig.json and tsconfig.app.json.
       The shadcn docs also show "baseUrl", which TypeScript 6 deprecates. Paths resolve
       relative to this file without it. See ADR-0005. */
    "paths": {
      "@/*": ["./src/*"]
    },

    /* Strictness. The template no longer enables strict, so it is set here explicitly.
       noUncheckedIndexedAccess is on because this codebase indexes into arrays of query
       rows constantly, and an undefined row read as a number is exactly the bug class
       that produces a silently wrong chart. */
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noImplicitOverride": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "erasableSyntaxOnly": true,
    "noFallthroughCasesInSwitch": true
  },
  "include": ["src"]
}
